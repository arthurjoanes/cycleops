      "additionalProperties": false,
      "properties": {
        "capacity": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Capacity"
        },
        "isVirtual": {
          "title": "Isvirtual",
          "type": "boolean"
        },
        "lat": {
          "title": "Lat",
          "type": "number"
        },
        "lon": {
          "title": "Lon",
          "type": "number"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "stationId": {
          "pattern": "^[A-Za-z0-9_-]{1,64}$",
          "title": "Stationid",
          "type": "string"
        }
      },
      "required": [
        "stationId",
        "name",
        "lat",
        "lon",
        "capacity",
        "isVirtual"
