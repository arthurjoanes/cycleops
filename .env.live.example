# Compose com o feed real. Copiar para .env.live e subir com
#   docker compose -p cycleops-live --env-file .env.live up
# O nome de projeto separa o volume do banco da simulação: o worker recusa
# iniciar num banco que já tem fluxo de outro modo.
CYCLEOPS_SOURCE=live

# Identificador que a Oslo Bysykkel exige em toda requisição ao feed,
# no formato <organização>-<aplicação>. O worker recusa rodar sem ele.
CYCLEOPS_CLIENT_IDENTIFIER=<seu-nome>-cycleops

# Rede própria do projeto live, para não colidir com a da simulação.
CYCLEOPS_NET=10.89.1
