# Identificador que a Oslo Bysykkel exige em toda requisição ao feed,
# no formato <organização>-<aplicação>. As CLIs de coleta recusam rodar sem ele.
CYCLEOPS_CLIENT_IDENTIFIER=<seu-nome>-cycleops

# Diretório da política. Padrão: policy/, a partir da raiz do repositório.
# CYCLEOPS_POLICY_DIR=policy

# Teto do banco em MB. Acima dele o worker suspende a ingestão até a purga
# trazer o tamanho de volta. Padrão: 1024.
# CYCLEOPS_DB_QUOTA_MB=1024

# Senhas do Compose. Sem elas valem os defaults local-only-* do compose.yaml,
# que só servem para uso local. Só letras, números, - e _, porque entram nas
# URLs de conexão. A do superusuário só vale na criação do volume; para trocar,
# docker compose down -v. As dos papéis o migrate reaplica a cada subida.
# CYCLEOPS_POSTGRES_PASSWORD=
# CYCLEOPS_MIGRATOR_DB_PASSWORD=
# CYCLEOPS_WORKER_DB_PASSWORD=
# CYCLEOPS_API_DB_PASSWORD=
