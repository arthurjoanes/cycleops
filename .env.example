# Identificador que a Oslo Bysykkel exige em toda requisição ao feed,
# no formato <organização>-<aplicação>. As CLIs de coleta recusam rodar sem ele.
CYCLEOPS_CLIENT_IDENTIFIER=<seu-nome>-cycleops

# Diretório da política. Padrão: policy/, a partir da raiz do repositório.
# CYCLEOPS_POLICY_DIR=policy
